{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDbTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-southeast-2:*:table/orders",
        "arn:aws:dynamodb:ap-southeast-2:*:table/orders/index/*"
      ]
    }
  ]
}
